{
  "name": "mendez95-open",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5173\"",
    "review": "node scripts/run-local-review.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "check": "npm run build && npm run test",
    "cf:typecheck": "tsc -p worker/tsconfig.json",
    "cf:test": "vitest run --config vitest.worker.config.ts",
    "public:check": "node scripts/check-public.mjs",
    "public:secrets": "node scripts/scan-secrets.mjs",
    "cf:dev": "wrangler dev --local --ip 127.0.0.1 --port 8787"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "express": "5.3.0",
    "nodemailer": "^10.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "description": "A forkable desktop and Pocket portfolio with fictional example content"
}
